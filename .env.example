# ============================================================================
# JobPilot configuration. Copy to `.env` and adjust.
# Every variable the application reads is documented here.
# ============================================================================

# --- Core -------------------------------------------------------------------
# Signs sessions and derives the key that encrypts stored API keys. Generate
# with: openssl rand -hex 32
# Leave it as `change-me` (or drop this whole file) and the containers
# generate one on first boot into the uploads volume — the app and worker
# share it. Set it explicitly if you want to control or back it up yourself.
SECRET_KEY=change-me
# Host port for the UI + API + WebSocket (one origin). Inside compose the
# container always listens on 1456 and this is what gets published to the
# host, so changing it here is enough — no other edit needed.
PORT=1456
# production | development | test
JOBPILOT_ENV=production
# Set when the UI is reachable beyond localhost (e.g. https://jobs.example.com).
# Turns on Secure cookies + HSTS. Put JobPilot behind a reverse proxy or a
# tailnet — see README "Remote access" — rather than raw port-forwarding.
#PUBLIC_URL=
# Force Secure cookies even without PUBLIC_URL (e.g. behind a TLS proxy).
SECURE_COOKIES=false
# Session cookie lifetime.
SESSION_TTL_DAYS=30

# --- Storage ----------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://jobpilot:jobpilot@db:5432/jobpilot
REDIS_URL=redis://redis:6379/0
# Uploaded files (resumes, cover letters, screenshots) — a named volume in
# compose. Paths are scoped per user and only served after an auth check.
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=15

# --- Postgres (compose only) ------------------------------------------------
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot
POSTGRES_DB=jobpilot

# --- LLM --------------------------------------------------------------------
# Required for resume parsing, listing summaries/match scores, field mapping
# and free-text drafts. What is sent to the API is documented in docs/PRIVACY.md.
# You can leave this blank and set the key in the UI instead:
# Settings -> AI (stored encrypted, never shown again).
ANTHROPIC_API_KEY=
# Model used for every AI task. Also settable per user in Settings -> AI.
# claude-opus-5 (best accuracy) | claude-sonnet-5 | claude-haiku-4-5 (cheapest)
LLM_MODEL=claude-opus-5
# 1 = deterministic offline fakes (tests / demo without a key).
LLM_DRY_RUN=0

# --- Job sources (all optional; a missing key disables that source) ---------
# Adzuna: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble: https://jooble.org/api/about
JOOBLE_API_KEY=
# USAJobs: https://developer.usajobs.gov/ (key + the email you registered)
USAJOBS_API_KEY=
USAJOBS_EMAIL=
# The Muse: https://www.themuse.com/developers/api/v2 (optional, raises rate limits)
THEMUSE_API_KEY=
# Search-engine discovery of ATS-hosted listings (site-scoped queries).
# Brave: https://brave.com/search/api/  ·  SerpAPI: https://serpapi.com/
BRAVE_SEARCH_API_KEY=
SERPAPI_API_KEY=

# --- Politeness -------------------------------------------------------------
# Hard floor of 1 second between requests to the same host. May only be
# raised (slower), never lowered — the app refuses to start otherwise.
MIN_HOST_INTERVAL_SECONDS=1.0
# Listing cache TTL so repeated searches don't re-fetch.
SOURCE_CACHE_TTL_SECONDS=1800
# Optional extra User-Agent suffix (e.g. your contact address). The UA always
# truthfully identifies JobPilot and links the repository.
#USER_AGENT_EXTRA=contact: you@example.com

# --- Application throughput ceilings (enforced server-side) -----------------
MAX_APPLICATIONS_PER_HOUR=15
MAX_APPLICATIONS_PER_DAY=50

# --- Human-in-the-loop ------------------------------------------------------
# Minutes to wait for a human answer before a job parks as
# needs_human (waiting) and the runner moves on. Never auto-continues.
INTERVENTION_WAIT_MINUTES=30

# --- Resolver ---------------------------------------------------------------
# LLM field-mappings below this confidence become interventions.
RESOLVER_CONFIDENCE_THRESHOLD=0.75
# Generated free-text answers longer than this need one-time approval.
FREETEXT_TRIVIAL_LENGTH=120

# --- Email notifications (optional) -----------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Server executor --------------------------------------------------------
# Headful Chromium under Xvfb so a human can take over via noVNC.
PLAYWRIGHT_HEADFUL=true
# Override the Chromium binary (usually unset; the image installs it).
#PLAYWRIGHT_CHROMIUM_PATH=
# Where the UI embeds the worker's noVNC viewer (compose default).
NOVNC_URL=http://localhost:1456/novnc/
