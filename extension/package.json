{
  "name": "jobpilot-extension",
  "version": "0.1.0",
  "description": "JobPilot — fills employer application forms in your own browser with your own answers. A human decides every CAPTCHA.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/webextension-polyfill": "^0.12.1",
    "typescript": "^5.5.4",
    "wxt": "^0.19.13"
  }
}
