# ---------------------------------------------------------------------------
# JobPilot worker image: the arq queue runner with a headful Playwright
# Chromium under Xvfb, exposed to the human via x11vnc + noVNC (websockify)
# so a CAPTCHA can be solved in the real page from the container UI.
# ---------------------------------------------------------------------------
FROM mcr.microsoft.com/playwright/python:v1.55.0-jammy
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 \
    DISPLAY=:99 SCREEN_GEOMETRY=1280x900x24
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
      xvfb x11vnc websockify novnc supervisor \
    && rm -rf /var/lib/apt/lists/*

COPY backend/pyproject.toml ./
RUN pip install --upgrade pip && pip install \
      "fastapi>=0.115" "sqlalchemy>=2.0.30" "alembic>=1.13" "pydantic>=2.7" \
      "pydantic-settings>=2.3" "email-validator>=2.1" "psycopg[binary]>=3.1" "httpx>=0.27" \
      "argon2-cffi>=23.1" "pyotp>=2.9" "qrcode>=7.4" "redis>=5.0" "arq>=0.26" \
      "playwright>=1.45" "beautifulsoup4>=4.12" "python-multipart>=0.0.9" "structlog>=24.1" \
      "anthropic>=0.69" "websockets>=12.0" "pypdf>=4.2" "python-docx>=1.1"

COPY backend/ ./
COPY docker/entrypoint-worker.sh /entrypoint-worker.sh
COPY docker/secret-key.sh /secret-key.sh
RUN chmod +x /entrypoint-worker.sh /secret-key.sh

# noVNC viewer (embedded in the authenticated JobPilot UI) on 6080.
EXPOSE 6080
ENTRYPOINT ["/entrypoint-worker.sh"]
