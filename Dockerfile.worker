# ---------------------------------------------------------------------------
# JobPilot worker image: the arq queue runner with a headful Playwright
# Chromium under Xvfb, exposed to the human via x11vnc + noVNC (websockify)
# so a CAPTCHA can be solved in the real page from the container UI.
# ---------------------------------------------------------------------------
FROM mcr.microsoft.com/playwright/python:v1.55.0-jammy
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 \
    DISPLAY=:99 SCREEN_GEOMETRY=1280x900x24 TZ=UTC
WORKDIR /app

# These pull in tzdata, whose configure step asks for a geographic area. A
# build has no terminal to answer with, so it doesn't fail — it waits forever.
# ARG rather than ENV: this is a build-time concern and shouldn't be baked
# into the shipped image's environment.
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      xvfb x11vnc websockify novnc supervisor \
    && rm -rf /var/lib/apt/lists/*

# Same single source of truth as the app image — see the note there. The
# worker imports the same application package, so it needs the same set;
# maintaining a second trimmed copy is what let cryptography go missing.
COPY backend/pyproject.toml backend/uv.lock ./
RUN pip install --upgrade pip uv \
    && uv export --frozen --no-dev --no-emit-project --no-hashes \
         --format requirements-txt -o /tmp/requirements.txt \
    && pip install --no-cache-dir -r /tmp/requirements.txt \
    && pip uninstall -y uv \
    && rm -f /tmp/requirements.txt

COPY backend/ ./
COPY docker/entrypoint-worker.sh /entrypoint-worker.sh
COPY docker/secret-key.sh /secret-key.sh
RUN chmod +x /entrypoint-worker.sh /secret-key.sh

# noVNC viewer (embedded in the authenticated JobPilot UI) on 6080.
EXPOSE 6080
ENTRYPOINT ["/entrypoint-worker.sh"]
